---
const stats = [
  { num: "4", label: "download formats", sub: "PNG · JPG · WEBP · SVG" },
  { num: "30%", label: "error correction", sub: "level H — badge-safe" },
  { num: "100%", label: "free & accessible", sub: "WCAG AA, keyboard-ready" },
  { num: "0", label: "trackers", sub: "runs in your browser" },
];
---

<section class="info info--band" aria-label="At a glance">
  <div class="container">
    <ul class="stats">
      {
        stats.map((s) => (
          <li class="stat">
            <span class="stat__num">{s.num}</span>
            <span class="stat__label">{s.label}</span>
            <span class="stat__sub">{s.sub}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
