---
// Interactive QR generator island. All behavior lives in the bundled
// client script below; this file is just accessible markup.
---

<section class="generator">
  <div class="input-group">
    <input
      type="url"
      id="url-input"
      placeholder="Enter a URL to generate a QR code"
      required
      aria-label="URL to encode"
      autocomplete="off"
      spellcheck="false"
    />
    <button id="generate-btn" type="button">Generate QR Code</button>
  </div>

  <label class="logo-toggle">
    <input type="checkbox" id="logo-toggle" checked />
    <span>Add the ICJIA logo to the center</span>
  </label>

  <!-- URL change confirmation (populated by the client script when needed) -->
  <div
    class="encoding-confirm hidden"
    role="dialog"
    aria-label="URL change confirmation"
  >
  </div>

  <div class="qr-container hidden">
    <div id="qrcode" role="img" aria-label="Generated QR code"></div>
    <a
      id="url-display"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Generated URL"></a>

    <div class="button-group">
      <div class="action-buttons">
        <button
          id="copy-btn"
          class="copy-btn"
          type="button"
          aria-label="Copy QR code to clipboard"
        >
          Copy QR Code
        </button>
        <div class="download-controls">
          <label class="sr-only" for="format-select">Download format</label>
          <select
            id="format-select"
            class="format-select"
            aria-label="Select download format"
          >
            <option value="png">PNG</option>
            <option value="jpg">JPG</option>
            <option value="webp">WEBP</option>
            <option value="svg">SVG</option>
          </select>
          <button
            id="download-btn"
            class="download-btn"
            type="button"
            aria-label="Download QR code"
          >
            Download
          </button>
        </div>
        <button
          id="reset-btn"
          class="reset-btn"
          type="button"
          aria-label="Reset form"
        >
          Reset
        </button>
      </div>
    </div>
  </div>

  <div
    class="test-warning hidden"
    role="alert"
    aria-label="Important testing warning"
  >
    <div class="warning-content">
      <span class="warning-icon" aria-hidden="true">⚠️</span>
      <div class="warning-text">
        <h3>Test your QR code</h3>
        <p>
          Scan this QR code with a mobile device before using it in production
          to verify it points to the correct URL.
        </p>
      </div>
    </div>
  </div>

  <div
    class="best-practices hidden"
    role="region"
    aria-label="QR code best practices"
  >
    <h2>QR Code Best Practices</h2>
    <div class="practices-list">
      <div class="practice-item">
        <span class="practice-icon" aria-hidden="true">🔍</span>
        <div class="practice-content">
          <h3>Test before sharing</h3>
          <p>Always test your QR code with multiple devices before sharing.</p>
        </div>
      </div>
      <div class="practice-item">
        <span class="practice-icon" aria-hidden="true">📏</span>
        <div class="practice-content">
          <h3>Minimum size</h3>
          <p>Print the QR code at least 2&times;2 cm (0.8&times;0.8 in).</p>
        </div>
      </div>
      <div class="practice-item">
        <span class="practice-icon" aria-hidden="true">🎨</span>
        <div class="practice-content">
          <h3>High contrast</h3>
          <p>Maintain strong contrast between dark and light elements.</p>
        </div>
      </div>
      <div class="practice-item">
        <span class="practice-icon" aria-hidden="true">⬜</span>
        <div class="practice-content">
          <h3>Quiet zone</h3>
          <p>Leave white space around the QR code for reliable scanning.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="toast-container" role="status" aria-live="polite"></div>

  <!-- QR code history -->
  <div
    id="history-modal"
    class="modal hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="history-modal-title"
  >
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-header-left">
          <h2 id="history-modal-title">My QR Codes</h2>
          <p class="history-explanation">
            Your QR code history is stored locally in your browser and can be
            deleted at any time.
          </p>
        </div>
        <div class="modal-header-right">
          <button
            id="delete-history-btn"
            class="delete-history-btn"
            type="button"
            aria-label="Delete QR code history"
          >
            Delete History
          </button>
          <button class="close-modal" type="button" aria-label="Close history"
            >&times;</button
          >
        </div>
      </div>
      <div class="modal-body">
        <div class="history-table-container">
          <table class="history-table">
            <thead>
              <tr>
                <th>Date / Time</th>
                <th>Original URL</th>
                <th>Encoded URL</th>
                <th>Generate</th>
              </tr>
            </thead>
            <tbody id="history-table-body"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <button id="history-btn" class="history-btn" type="button">
    My QR Codes
  </button>
</section>

<script>
  import "../scripts/generator.js";
</script>
