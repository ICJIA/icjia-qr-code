---
import BaseLayout from "../layouts/BaseLayout.astro";
import QrGenerator from "../components/QrGenerator.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Stats from "../components/Stats.astro";
import ErrorCorrection from "../components/ErrorCorrection.astro";
---

<BaseLayout title="QR Code Generator | ICJIA">
  <div class="container">
    <header class="page-head">
      <h1>QR Code Generator</h1>
      <p class="lead">
        Create accessible, downloadable QR codes for any URL &mdash; with
        optional ICJIA branding in the center. New to QR codes? Start with
        <a href="/what-is-a-qr-code/">the basics</a>.
      </p>
    </header>

    <QrGenerator />
  </div>

  <HowItWorks />
  <Stats />
  <ErrorCorrection />
</BaseLayout>
