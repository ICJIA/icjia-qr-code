---
import "@fontsource-variable/public-sans";
import "@fontsource-variable/archivo";
import "../styles/global.css";
import { SEO } from "astro-seo";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const {
  title = "QR Code Generator",
  description = "Generate free, accessible QR codes for any URL, with an optional ICJIA badge. A tool from the Illinois Criminal Justice Information Authority.",
  image = "/og-image.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const isHome = Astro.url.pathname === "/";

// Build-time dates for freshness signals (static site).
const buildDate = new Date();
const published = "2026-06-06";
const modified = buildDate.toISOString().slice(0, 10);
// Full ISO 8601 timestamps for the Open Graph article:* meta tags below. Some AI
// and SEO crawlers read these flat meta tags but do not traverse dates nested in
// the JSON-LD @graph, so we expose freshness both ways.
const publishedTime = `${published}T00:00:00+00:00`;
const modifiedTime = buildDate.toISOString();

const orgId = new URL("#org", Astro.site).href;
const siteId = new URL("#website", Astro.site).href;
const ORG_NAME = "Illinois Criminal Justice Information Authority";

const graph = [
  {
    "@type": "Organization",
    "@id": orgId,
    name: ORG_NAME,
    alternateName: "ICJIA",
    url: "https://icjia.illinois.gov",
  },
  {
    "@type": "WebSite",
    "@id": siteId,
    url: Astro.site.href,
    name: "ICJIA QR Code Generator",
    inLanguage: "en",
    publisher: { "@id": orgId },
  },
  {
    "@type": "WebPage",
    "@id": canonical + "#webpage",
    url: canonical,
    name: title,
    description,
    inLanguage: "en",
    isPartOf: { "@id": siteId },
    primaryImageOfPage: ogImage,
    datePublished: published,
    dateModified: modified,
    author: { "@id": orgId },
    publisher: { "@id": orgId },
  },
];

if (isHome) {
  graph.push({
    "@type": "WebApplication",
    name: "ICJIA QR Code Generator",
    url: canonical,
    description,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    browserRequirements: "Requires JavaScript",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    inLanguage: "en",
    author: { "@id": orgId },
    publisher: { "@id": orgId },
    datePublished: published,
    dateModified: modified,
  });
}

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: { title, type: "website", image: ogImage, url: canonical },
        optional: { siteName: "ICJIA QR Code Generator", description },
        article: { publishedTime, modifiedTime },
        image: {
          alt: "ICJIA QR Code Generator",
          width: 1200,
          height: 630,
          type: "image/png",
        },
      }}
      twitter={{
        card: "summary_large_image",
        title,
        description,
        image: ogImage,
        imageAlt: "ICJIA QR Code Generator",
      }}
      extend={{
        meta: [
          { name: "theme-color", content: "#23356a" },
          { name: "author", content: `${ORG_NAME} (ICJIA)` },
        ],
        link: [
          { rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
          { rel: "icon", type: "image/png", href: "/favicon.png" },
          { rel: "apple-touch-icon", href: "/apple-touch-icon.png" },
        ],
      }}
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Set theme before paint to avoid a flash of the wrong color scheme -->
    <script is:inline>
      (function () {
        try {
          // Default to dark mode unless the visitor has explicitly chosen light.
          var saved = localStorage.getItem("theme");
          var dark = saved ? saved === "dark" : true;
          document.documentElement.setAttribute(
            "data-theme",
            dark ? "dark" : "light",
          );
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
