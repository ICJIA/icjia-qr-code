---
import "@fontsource-variable/public-sans";
import "@fontsource-variable/fraunces";
import "../styles/global.css";
import { SEO } from "astro-seo";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const {
  title = "QR Code Generator",
  description = "Generate accessible, downloadable QR codes for any URL, with optional ICJIA branding. A free tool from the Illinois Criminal Justice Information Authority.",
  image = "/og-image.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: { title, type: "website", image: ogImage, url: canonical },
        optional: { siteName: "ICJIA QR Code Generator", description },
        image: {
          alt: "ICJIA QR Code Generator",
          width: 1200,
          height: 630,
          type: "image/png",
        },
      }}
      twitter={{
        card: "summary_large_image",
        title,
        description,
        image: ogImage,
        imageAlt: "ICJIA QR Code Generator",
      }}
      extend={{
        meta: [{ name: "theme-color", content: "#23356a" }],
        link: [
          { rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
          { rel: "icon", type: "image/png", href: "/favicon.png" },
          { rel: "apple-touch-icon", href: "/apple-touch-icon.png" },
        ],
      }}
    />

    <!-- Set theme before paint to avoid a flash of the wrong color scheme -->
    <script is:inline>
      (function () {
        try {
          // Default to dark mode unless the visitor has explicitly chosen light.
          var saved = localStorage.getItem("theme");
          var dark = saved ? saved === "dark" : true;
          document.documentElement.setAttribute(
            "data-theme",
            dark ? "dark" : "light",
          );
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
